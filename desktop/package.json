{
  "name": "codexa-desktop",
  "productName": "Codexa",
  "version": "2.1.0",
  "description": "Codexa for Windows: a native app for building software with AI.",
  "author": "Codexa",
  "homepage": "https://codexa.creditvault.tech",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "vite build --mode development && electron .",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p renderer/tsconfig.json",
    "start": "electron .",
    "dist:win": "vite build && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "38.2.0",
    "electron-builder": "26.0.12",
    "lucide-react": "1.61.0",
    "monaco-editor": "0.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "tech.creditvault.codexa",
    "productName": "Codexa",
    "copyright": "© Codexa",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist-renderer/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Codexa-Setup-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Codexa",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true,
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sangralrahul",
        "repo": "codexa",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sangralrahul/codexa.git"
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  }
}
