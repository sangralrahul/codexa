# Copy to .dev.vars for `npm run cf:preview` (local Cloudflare runtime).
# On Cloudflare itself, set these as Worker secrets/variables instead.
SESSION_SECRET=
ENCRYPTION_KEY=
APP_URL=http://localhost:8787
NEXT_PUBLIC_APP_URL=http://localhost:8787
ANTHROPIC_API_KEY=
CUSTOMERIO_APP_API_KEY=
CUSTOMERIO_REGION=us
EMAIL_FROM="Codexa <no-reply@example.com>"
# Live previews and hosted sites on your computer (browsers send *.localhost
# to your own machine). They also need the "containers" block in
# wrangler.jsonc turned on and Docker running.
PREVIEW_HOST=preview.localhost:8787
DEPLOY_HOST=sites.localhost:8787
PREVIEW_PROTOCOL=http
