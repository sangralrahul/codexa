# ---------------------------------------------------------------------------
# Codexa environment configuration. Copy to .env.local and fill in values.
# Variables marked (required) must be set for the app to start.
# ---------------------------------------------------------------------------

# App (required)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (required) - PostgreSQL 14+
DATABASE_URL=postgres://codexa:codexa@127.0.0.1:5432/codexa
# Used only by `npm test` (integration tests). Must be a separate database.
TEST_DATABASE_URL=postgres://codexa:codexa@127.0.0.1:5432/codexa_test

# Secrets (required). Generate with: openssl rand -base64 32
SESSION_SECRET=
ENCRYPTION_KEY=

# Runner service (required for live preview / builds / deployments)
RUNNER_URL=http://127.0.0.1:4000
RUNNER_TOKEN=change-me-runner-token
RUNNER_PORT=4000
RUNNER_PREVIEW_PORT=4100
# Public host suffix for previews. Browsers resolve *.localhost to 127.0.0.1.
PREVIEW_HOST=preview.localhost:4100
PREVIEW_PROTOCOL=http
# Where sandboxes, base dependency sets and deployed sites live.
RUNNER_DATA_DIR=/var/codexa
# Sandbox driver: local (namespaces + cgroups), docker, or e2b
RUNNER_SANDBOX_DRIVER=local
# Unprivileged uid/gid used by the local sandbox driver
RUNNER_SANDBOX_UID=65534
RUNNER_SANDBOX_GID=65534

# AI providers (at least one is required for AI generation)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Default model, e.g. claude-sonnet-5-5 or gpt-5
AI_DEFAULT_PROVIDER=anthropic
AI_DEFAULT_MODEL=claude-sonnet-5-5

# Email (optional). Without RESEND_API_KEY, emails are written to the
# email_outbox table and viewable at /dev/mailbox in development.
RESEND_API_KEY=
EMAIL_FROM="Codexa <no-reply@codexa.local>"

# GitHub OAuth app (optional, enables Sign in with GitHub and repo import/push)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Billing (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Deployment providers (optional). Codexa static hosting works without any.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
# Public host suffix for Codexa-hosted deployments (served by the runner).
DEPLOY_HOST=sites.localhost:4100

# Sandbox providers (optional)
E2B_API_KEY=

# Admin bootstrap: comma-separated emails that get the admin role on signup.
ADMIN_EMAILS=

# Realtime collaboration server
REALTIME_PORT=4200
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4200
