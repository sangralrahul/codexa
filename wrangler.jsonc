{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker's name in your Cloudflare account. Keep it in sync with
  // WORKER_SELF_REFERENCE below.
  "name": "codexa",
  // worker/index.ts wraps the Next.js app built by OpenNext (.open-next/) and
  // adds previews, hosted sites, realtime presence and cron jobs.
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "codexa"
    }
  ],
  // Codexa's database. Wrangler creates it on the first deploy; migrations
  // live in ./drizzle and are applied with `npm run db:migrate:remote`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codexa",
      "migrations_dir": "drizzle"
    }
  ],
  // Project snapshots and Codexa-hosted sites. Created on the first deploy.
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "codexa-storage"
    }
  ],
  // One Durable Object per project for its container (SANDBOX) and its
  // realtime presence room (PRESENCE).
  "durable_objects": {
    "bindings": [
      { "name": "SANDBOX", "class_name": "ProjectSandbox" },
      { "name": "PRESENCE", "class_name": "PresenceRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProjectSandbox", "PresenceRoom"] }
  ],
  // Live previews and builds: each project runs in its own container
  // (instance size is chosen in worker/sandbox.ts). They need your own domain
  // (see "routes" below). Without one, put // in front of these lines.
  // Docker must be running when you deploy: Wrangler builds the image with it.
  "containers": [
    {
      "name": "codexa-runner",
      "class_name": "ProjectSandbox",
      "scheduling_policy": "durable_object",
      "images": {
        "runner": { "dockerfile": "./containers/runner/Dockerfile", "build_context": "." }
      }
    }
  ],
  // Background jobs (email retries, cleanup) every 5 minutes.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  // Your own domain (it must be a zone in your Cloudflare account). Without
  // one, put // in front of these lines and empty PREVIEW_HOST/DEPLOY_HOST
  // below; Codexa then runs at codexa.<your-subdomain>.workers.dev.
  // See docs/CLOUDFLARE.md.
  "routes": [
    { "pattern": "codexa.creditvault.tech", "custom_domain": true },
    // www.… is answered by the Worker too, which redirects it to the address above (worker/index.ts).
    { "pattern": "www.codexa.creditvault.tech", "custom_domain": true },
    { "pattern": "*-preview.creditvault.tech/*", "zone_name": "creditvault.tech" },
    { "pattern": "*-sites.creditvault.tech/*", "zone_name": "creditvault.tech" }
  ],
  // Plain (non-secret) settings. Secrets, and APP_URL (your site's address),
  // go in with `npx wrangler secret put`. The leading dash in PREVIEW_HOST
  // and DEPLOY_HOST gives abc-preview.creditvault.tech (one level deep, so
  // Cloudflare's free certificate covers it). Without a domain, set both to "".
  // For `npm run cf:preview`, .dev.vars overrides these.
  "vars": {
    "NODE_ENV": "production",
    "PREVIEW_HOST": "-preview.creditvault.tech",
    "DEPLOY_HOST": "-sites.creditvault.tech",
    "PREVIEW_PROTOCOL": "https"
  }
}
