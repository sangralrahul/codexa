{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker's name in your Cloudflare account. Keep it in sync with
  // WORKER_SELF_REFERENCE below.
  "name": "codexa",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "codexa"
    }
  ],
  // Codexa's database. Wrangler creates it on the first deploy; migrations
  // live in ./drizzle and are applied with
  //   npx wrangler d1 migrations apply codexa --remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codexa",
      "migrations_dir": "drizzle"
    }
  ],
  // Project snapshots and Codexa-hosted sites. Created on the first deploy.
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "codexa-storage"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Plain (non-secret) settings. Secrets go in with `npx wrangler secret put`.
  "vars": {
    "NODE_ENV": "production"
  }
}
