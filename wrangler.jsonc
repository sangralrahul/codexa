{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker's name in your Cloudflare account. Keep it in sync with
  // WORKER_SELF_REFERENCE below.
  "name": "codexa",
  // worker/index.ts wraps the Next.js app built by OpenNext (.open-next/) and
  // adds previews, hosted sites, realtime presence and cron jobs.
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "codexa"
    }
  ],
  // Codexa's database. Wrangler creates it on the first deploy; migrations
  // live in ./drizzle and are applied with `npm run db:migrate:remote`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codexa",
      "migrations_dir": "drizzle"
    }
  ],
  // Project snapshots and Codexa-hosted sites. Created on the first deploy.
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "codexa-storage"
    }
  ],
  // One Durable Object per project for its container (SANDBOX) and its
  // realtime presence room (PRESENCE).
  "durable_objects": {
    "bindings": [
      { "name": "SANDBOX", "class_name": "ProjectSandbox" },
      { "name": "PRESENCE", "class_name": "PresenceRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProjectSandbox", "PresenceRoom"] }
  ],
  // Live previews and builds: each project runs in its own container
  // (instance size is chosen in worker/sandbox.ts). They need your own domain
  // (see "routes" below), so they are off by default. To turn them on, remove
  // the // in front of these lines. Docker must be running when you deploy:
  // Wrangler builds the container image with it.
  // "containers": [
  //   {
  //     "name": "codexa-runner",
  //     "class_name": "ProjectSandbox",
  //     "scheduling_policy": "durable_object",
  //     "images": {
  //       "runner": { "dockerfile": "./containers/runner/Dockerfile", "build_context": "." }
  //     }
  //   }
  // ],
  // Background jobs (email retries, cleanup) every 5 minutes.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  // Your own domain (optional; without it Codexa runs at
  // codexa.<your-subdomain>.workers.dev). Uncomment and replace example.com
  // with your domain (it must be a zone in your Cloudflare account).
  // See "Add your own domain" in docs/CLOUDFLARE.md.
  // "routes": [
  //   { "pattern": "codexa.example.com", "custom_domain": true },
  //   { "pattern": "*-preview.example.com/*", "zone_name": "example.com" },
  //   { "pattern": "*-sites.example.com/*", "zone_name": "example.com" }
  // ],
  // Plain (non-secret) settings. Secrets, and APP_URL (your site's address),
  // go in with `npx wrangler secret put`. PREVIEW_HOST and DEPLOY_HOST stay
  // empty until you add a domain; then set them to -preview.example.com and
  // -sites.example.com (the leading dash gives abc-preview.example.com, which
  // Cloudflare's free certificate covers). For `npm run cf:preview`,
  // .dev.vars overrides these.
  "vars": {
    "NODE_ENV": "production",
    "PREVIEW_HOST": "",
    "DEPLOY_HOST": "",
    "PREVIEW_PROTOCOL": "https"
  }
}
