{
  "name": "codexa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently -n web,runner,realtime -c blue,green,magenta \"npm:dev\" \"npm:runner:dev\" \"npm:realtime:dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply codexa --local",
    "db:seed": "tsx scripts/seed.ts",
    "runner:dev": "tsx watch services/runner/index.ts",
    "runner:start": "tsx services/runner/index.ts",
    "runner:prepare": "tsx services/runner/prepare.ts",
    "realtime:dev": "tsx watch services/realtime/index.ts",
    "realtime:start": "tsx services/realtime/index.ts",
    "postinstall": "node scripts/copy-monaco.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "prebuild": "tsx scripts/generate-api-manifest.ts && tsx scripts/generate-content-bundle.ts",
    "api:manifest": "tsx scripts/generate-api-manifest.ts",
    "user:admin": "tsx scripts/user-admin.ts",
    "predev": "tsx scripts/generate-api-manifest.ts && tsx scripts/generate-content-bundle.ts",
    "content:bundle": "tsx scripts/generate-content-bundle.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:migrate:remote": "wrangler d1 migrations apply codexa --remote",
    "db:migrate:test": "wrangler d1 migrations apply codexa --local --persist-to .wrangler/test-state"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@cloudflare/sandbox": "^1.0.3",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.8.2",
    "gray-matter": "^4.0.3",
    "http-proxy": "^1.18.1",
    "lucide-react": "^1.61.0",
    "minisearch": "^7.2.0",
    "monaco-editor": "^0.57.0",
    "next": "16.4.3",
    "openai": "^7.43.0",
    "pg": "^8.23.1",
    "pg-cloudflare": "^1.4.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.8",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^23.0.1",
    "tailwind-merge": "^3.7.0",
    "tar": "^7.5.22",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261025.1",
    "@opennextjs/cloudflare": "^1.20.13",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright": "1.63.0",
    "playwright-core": "1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
